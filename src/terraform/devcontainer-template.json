        "1-trixie",
        "1-bookworm"
      ],
      "default": "1-trixie"
    }
  },
  "platforms": [
    "Terraform"
  ],
  "keywords": [
    "terraform",
    "infrastructure",
    "iac",
    "hcl",
    "terraform-ls",
    "security",
    "hardened",
    "non-root"
