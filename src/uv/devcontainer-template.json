        "trixie",
        "bookworm"
      ],
      "default": "trixie"
    }
  },
  "platforms": [
    "Python"
  ],
  "keywords": [
    "uv",
    "python",
    "pip",
    "venv",
    "astral",
    "ruff",
    "security",
    "hardened",
    "non-root"
  ]
}
