{
  "id": "uv",
  "version": "1.0.8",
  "name": "Python (uv)",
  "description": "Security-focused Python dev container with uv, hardened defaults, and cached packages.",
  "publisher": "Bare Dev Container Maintainers",
  "documentationURL": "https://github.com/bare-devcontainer/templates/tree/main/src/uv",
  "licenseURL": "https://github.com/bare-devcontainer/templates/blob/main/LICENSE",
  "options": {
    "imageVariant": {
