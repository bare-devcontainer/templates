// Created from the "rustup" template of Bare Dev Container Templates.
// Usage, options, security defaults, and tips: https://github.com/bare-devcontainer/templates/tree/main/src/rustup
// What is installed in the image, and available tags: https://github.com/bare-devcontainer/images
{
  "name": "Rust",
  // Recommended: pin to a digest (e.g. "ghcr.io/bare-devcontainer/rustup:trixie@sha256:<digest>").
  // See https://github.com/bare-devcontainer/templates#pinning-images-to-a-digest
  "image": "ghcr.io/bare-devcontainer/rustup:${templateOption:imageVariant}",
  "remoteUser": "dev",
  "runArgs": ["--cap-drop=ALL"],
  // Uncomment the following options to enable the debugger.
  // "capAdd": ["SYS_PTRACE"],
  // Remove "no-new-privileges" if users need to gain elevated privileges inside the container (e.g., su, sudo).
  "securityOpt": ["no-new-privileges"],
  "init": true,
  // Installs the toolchain the project pins in rust-toolchain.toml, or a minimal stable toolchain
  // as the default when none is pinned, and the rust-src component rust-analyzer needs for std.
  // --no-self-update keeps the rustup the image verified at build time.
  "postCreateCommand": "if rustup show active-toolchain >/dev/null 2>&1; then rustup toolchain install --no-self-update && rustup component add rust-src; else rustup toolchain install stable --profile minimal --component clippy,rustfmt,rust-analyzer,rust-src --no-self-update && rustup default stable; fi",
  // If you use VS Code, uncomment the following to open $EDITOR/$VISUAL/$GIT_EDITOR (e.g. `git commit`) in a VS Code tab:
  // "remoteEnv": {
  //   "VISUAL": "code --wait",
  //   "EDITOR": "code --wait",
  //   "GIT_EDITOR": "code --wait"
  // },
  "mounts": [
    // Persist installed toolchains across rebuilds to avoid re-downloading them.
    // Toolchains here are not reset by a rebuild; remove this mount to get a fresh download each time.
    {
      "source": "${devcontainerId}-rustup-home",
      "target": "/home/dev/.rustup",
      "type": "volume"
    },
    // Persist the Cargo registry cache across rebuilds to avoid re-downloading crates.
    // ~/.cargo/bin is intentionally left in the image layer, so rustup comes from the image.
    {
      "source": "${devcontainerId}-rustup-cargo-registry",
      "target": "/home/dev/.cargo/registry",
      "type": "volume"
    },
    // Persist Cargo's cache of git-sourced dependencies across rebuilds.
    {
      "source": "${devcontainerId}-rustup-cargo-git",
      "target": "/home/dev/.cargo/git",
      "type": "volume"
    },
    // Persist the shell history the image keeps in this directory.
    {
      "source": "${devcontainerId}-bash-history",
      "target": "/home/dev/.local/state/bash",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "[rust]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  }
}
