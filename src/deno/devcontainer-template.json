{
  "id": "deno",
  "version": "1.0.3",
  "name": "Deno",
  "description": "Security-focused Deno dev container for JS/TS with hardened defaults and cached modules.",
  "publisher": "Bare Dev Container Maintainers",
  "documentationURL": "https://github.com/bare-devcontainer/templates/tree/main/src/deno",
  "licenseURL": "https://github.com/bare-devcontainer/templates/blob/main/LICENSE",
  "options": {
    "imageVariant": {
      "type": "string",
      "description": "Deno and Debian version (trixie = Debian 13, bookworm = Debian 12). Other published tags can be entered.",
      "proposals": [
        "2-trixie",
        "2-bookworm"
      ],
      "default": "2-trixie"
    }
  },
  "platforms": [
    "Deno",
    "JavaScript",
    "TypeScript"
  ],
  "keywords": [
    "deno",
    "javascript",
    "js",
    "typescript",
    "ts",
    "security",
    "hardened",
    "non-root"
  ]
}
